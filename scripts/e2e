#!/bin/sh
# Runs the Playwright browser tests in e2e/ against the app-e2e compose
# service (port 3001, database thing_for_doing_next_e2e). The dev server and
# its data are untouched. Arguments are passed to `playwright test`.
set -eu
cd "$(dirname "$0")/.."

database=thing_for_doing_next_e2e
url=http://localhost:3001

cleanup() {
    docker compose --profile e2e rm --stop --force app-e2e >/dev/null 2>&1 || true
}
trap cleanup EXIT INT TERM

docker compose up --detach --wait db
docker compose exec -T db sh -c "psql -U thing_for_doing -d thing_for_doing_next -lqt | cut -d'|' -f1 | grep -qw $database || createdb -U thing_for_doing $database"
docker compose --profile e2e up --build --detach app-e2e

echo "waiting for $url"
attempts=0
until curl -fsS "$url/up" >/dev/null 2>&1; do
    attempts=$((attempts + 1))
    if [ "$attempts" -gt 180 ]; then
        docker compose --profile e2e logs app-e2e
        echo "app-e2e did not start" >&2
        exit 1
    fi
    sleep 1
done

cd e2e
if [ ! -f node_modules/.package-lock.json ] || [ package-lock.json -nt node_modules/.package-lock.json ]; then
    npm ci --no-audit --no-fund
fi
E2E_BASE_URL="$url" npx playwright test "$@"
